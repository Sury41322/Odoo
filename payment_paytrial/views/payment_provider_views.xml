<?xml version='1.0' encoding='utf-8' ?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">paytrial Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <page name="credentials" position="attributes">
                <group>
                    <field name="paytrial_merchant_key" />
                    <field name="paytrial_secret_key" />
                </group>
                <attribute name="invisible" separator="or" add="code == 'paytrial'"/>
            </page>
        </field>
    </record>

</odoo>
