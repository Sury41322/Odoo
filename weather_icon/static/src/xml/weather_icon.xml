<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="weather_icon">
        <Dropdown>
            <div class="new_icon">
                 <div class="icon_div">
                     <div class="toggle-icon" role="button">
                       <i id='weather_info' t-on-click="_onClick"
                          class="fa fa-sun-o fa-1.5x"
                          style="color: white; margin-bottom:10px; padding:13px;"
                          role="img" aria-label="Weather Information"/>
                     </div>
                 </div>
            </div>
            <t t-set-slot="content">
                 <div class="weather m-2 p-2" style=" justify-content: center;">
                     <div class=" row ">
                         <div class="col-sm-8">
                        <input type="text" class="form-control" name="city" id="place" placeholder="Enter city, country..."/>
                             </div>
                         <div class="col-sm-4">
                         <button type="button" name="weather_data_place" t-on-click="_on_submit"
                                 class="btn btn-primary text-center" >
                            Search</button>
                         </div>
                     </div>
                     <div class="row mt-2">
                         <div class="col-sm-6"></div>
                         <div class="col-sm-2"></div>
                         <div class="col-sm-4">
                             <select name="metrics" id="temp_metrics" class="form-select" t-on-change="temp_metrics">
                              <option value="c" selected="True">°C</option>
                              <option value="f">°F</option>
                            </select>
                         </div>
                     </div>
                     <div class="text-center m-3 p-3">
                        <t class="weather_info">
                            <div id="weather-container">
                                <t t-if="state.weather">
                                    <h1 id="temp">
                                        <t t-if="state.fahrenheit">
                                            <t t-esc="state.temp"/>°F
                                        </t>
                                        <t t-else="">
                                            <t t-esc="state.temp"/>°C
                                        </t>
                                    </h1>
                                    <h3>
                                        <t t-esc="state.weather.weather[0].main"/>
                                    </h3>
                                    <img t-att-src="state.icon"/>
                                    <h5>
                                        <t t-esc="state.weather.weather[0].description"/>
                                        <span> in </span>
                                        <h3><b><t t-esc="state.weather.name"/></b></h3>
                                    </h5>
                                </t>
                                <t t-else="">
                                    <h1>Loading...</h1>
                                </t>
                            </div>
                            <div class="time">
                                 <span>Last Update :</span>
                                <br/>
                                <t t-esc="state.time"/>
                             </div>
                         </t>
                     </div>
                 </div>
             </t>
        </Dropdown>
    </t>
</templates>
