<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.rating</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pos']" position="inside">
                <field name="pos_rating" />
            </xpath>
        </field>
    </record>

    <record id="pos_product_view_form_normalized_inherit" model="ir.ui.view">
        <field name="name">product.view.form.normalized.inherit.pos.rating</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="point_of_sale.product_product_view_form_normalized_pos"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="pos_rating"/>
            </xpath>
        </field>
    </record>
</odoo>

