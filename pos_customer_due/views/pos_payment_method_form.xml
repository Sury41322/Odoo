<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pos_customer_due_payment_method_form" model="ir.ui.view">
        <field name="name">pos.payment.method.pos.customer.due.form.inherit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='Payment methods']" position="inside">
                <group>
                    <field name="is_ledger"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
