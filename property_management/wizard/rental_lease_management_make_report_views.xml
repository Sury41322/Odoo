<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rental_lease_management_make_report_form_view" model="ir.ui.view">
        <field name="name">rental_lease_management_make_report_form_view</field>
        <field name="model">rental.lease.management.make.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="from_date" string="From"/>
                        <field name="to_date" string="To"/>
                        <field name="tenant_ids" widget="many2many_tags"/>
                        <field name="owner_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="property_ids" widget="many2many_tags"/>
                        <field name="state"/>
                        <field name="type"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="oe_highlight"/>
                    <button name="action_print_xlsx" type="object" string="Print XLSX"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="rental_lease_management_make_report_form" model="ir.actions.act_window">
        <field name="name">Rental/Lease Report</field>
        <field name="res_model">rental.lease.management.make.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>