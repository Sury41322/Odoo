<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    snippet template -->
    <template id="lastest_property_template_snippet" name="latest_property">
        <section class="property_section">
            <div class="property_div">
                <div class="alert alert-info">
                    <h4>Your Category Highlight Tab snippet will be displayed here...
                        Please save to view the snippet
                    </h4>
                </div>
            </div>
        </section>
    </template>
    <!--    snippet inheriting template-->
    <template id="snippet" inherit_id="website.snippets" name="Best seller Snippet">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="property_management.lastest_property_template_snippet"
               t-thumbnail="property_management/static/src/img/snippets/property.png"/>
        </xpath>
    </template>
    <!--   Property details-->
    <template id="property_details" name="Property">
        <t t-call="website.layout">
            <div class="oe_structure">
                <div class="container new_form pt-3 pb-3">

                    <div class="row" id="property_detail_main">
                        <div class="col-lg-6 mt-lg-4 o_wsale_product_images position-relative">
                            <div class="position-relative d-inline-flex overflow-hidden m-auto w-100">
                                <div name="o_img_with_max_suggested_width"
                                     class="d-flex align-items-start justify-content-center w-100 oe_unmovable">
                                    <t t-if="property.property_image">
                                        <img t-att-src="image_data_uri(property.property_image)"
                                             class="img img-fluid oe_unmovable product_detail_img w-100 rounded"/>
                                    </t>
                                    <t t-else="">
                                        <img src="/property_management/static/src/img/rent.png"
                                             class="img img-fluid oe_unmovable product_detail_img w-100 rounded"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div id="property_details" class="col-lg-6 mt-md-4">
                            <div class="js_product js_main_product row position-sticky">
                                <div class="col-lg-8">
                                    <center>
                                        <h1 class="h3">
                                            <t t-esc="property.name"/>
                                        </h1>
                                    </center>
                                    <form>
                                        <input type="hidden" name="csrf_token">
                                            <div class="mt-3">
                                                <span>
                                                    <h5>
                                                        <u>Owner Information</u>
                                                    </h5>
                                                </span>
                                                <div name="property_details"
                                                     class="property_details text-end mt-1 d-inline-block">
                                                    <div name="property_details_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="owner_name">
                                                            <t t-esc="property.owner_id.name"/>
                                                        </span>
                                                    </div>
                                                    <div name="property_details_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="owner_phone">
                                                            <t t-esc="property.owner_id.phone"/>
                                                        </span>
                                                    </div>
                                                    <div name="property_details_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="owner_main">
                                                            <t t-esc="property.owner_id.email"/>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <span>
                                                    <h5>
                                                        <u>Property Price</u>
                                                    </h5>
                                                </span>
                                                <div name="property_price"
                                                     class="product_price text-end mt-1 d-inline-block">
                                                    <div name="product_price_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="oe_price" style="white-space: nowrap;">Rent :
                                                            <span class="oe_currency_value">
                                                                <t t-esc="property.rent"/>
                                                            </span>
                                                        </span>
                                                    </div>
                                                    <div name="product_price_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="oe_price" style="white-space: nowrap;">Lease :
                                                            <span class="oe_currency_value">
                                                                <t t-esc="property.legal_amount"/>
                                                            </span>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <span>
                                                    <h5>
                                                        <u>Location</u>
                                                    </h5>
                                                </span>
                                                <div name="property_details"
                                                     class="property_details text-end mt-1 d-inline-block">
                                                    <div name="property_details_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="owner_name">
                                                            <t t-esc="property.address"/>
                                                        </span>
                                                    </div>
                                                    <div name="property_details_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="owner_name">
                                                            <t t-esc="property.city"/>
                                                        </span>
                                                        <span>
                                                            <t t-esc="property.zip_code"/>
                                                        </span>
                                                    </div>
                                                    <div name="property_details_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="owner_phone">
                                                            <t t-esc="property.state_id.name"/>
                                                        </span>
                                                    </div>
                                                    <div name="property_details_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="owner_main">
                                                            <t t-esc="property.country_id.name"/>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <span>
                                                    <h5>
                                                        <u>Details</u>
                                                    </h5>
                                                </span>
                                                <div name="property_details"
                                                     class="property_built_date text-end mt-1 d-inline-block">
                                                    <div name="property_date_container"
                                                         class="css_editable_mode_hidden d-flex align-items-center gap-2 flex-wrap h6 mb-0 text-wrap">
                                                        <span class="oe_date" style="white-space: nowrap;">
                                                            <span>
                                                                <b>Built Date :</b>
                                                            </span>
                                                            <t t-esc="property.built_date"/>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </input>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
