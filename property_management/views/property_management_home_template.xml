<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_rent_lease_order" name="Rent / Lease" customize_show="True" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_category')]" position="inside">
            <div class="o_portal_index_card col-md-6 order-2">
                <a href="/my/rental_lease_order" title="Rent &amp; Lease"
                   class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-block align-self-start">
                        <img src="/property_management/static/src/img/rent.png" loading="lazy" style="" width="45"/>
                    </div>
                    <div class="">
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1 ">
                            <span>Rent &amp; Lease</span>
                        </div>
                        <div class="opacity-75">
                            Configure your Rent or Lease Orders
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>
<!--Rent Lease Orders Page View-->
    <template id="portal_my_rental_lease_order" name="My Rent/Lease Order">
        <t t-call="website.layout">
            <div class="oe_structure">
                <div class="container pt-5 pb-5">
                    <h1 class="pb-2">Rental/Lease Order</h1>
                    <t t-call="portal.portal_table">
                        <thead>
                            <tr>
                                <th>Rental/Lease #</th>
                                <th class="text-end">Start Date</th>
                                <th class="text-end">Valid Until</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <t t-foreach="order" t-as="order">
                            <tr>
                                <td>
                                    <a t-attf-href="/rental_lease_order/#{order.id}">
                                        <t t-out="order.name"/>
                                    </a>
                                </td>
                                <td class="text-end">
                                    <span t-field="order.start_date"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="order.end_date"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="order.sub_total"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>
<!--Detailed Information Page-->
    <template id="portal_rent_order">
        <t t-call="website.layout">
            <div class="oe_structure">
                <div class="container pt-5 pb-5">
                    <div class="container o_portal_sidebar">
                        <div id="introduction" class="border-bottom-0 pt-0 pb-3">
                            <div class="d-flex gap-2" id="intro_row">
                                <h2 id="quote_header_2" data-anchor="true">
                                    Rent/Lease
                                    <br/>
                                    <em>
                                        <t t-esc="order.name"/>
                                    </em>
                                </h2>
                            </div>
                        </div>
                        <div id="content">
                            <div id="informations" class="row">
                                <div id="sale_info" class="col-12 col-lg-6 mb-4">
                                    <span id="order_info_title">
                                        <h5 class="mb-1">Order Information</h5>
                                        <hr class="mt-1 mb-2"/>
                                    </span>
                                    <table class="table table-borderless table-sm">
                                        <tbody style="white-space:nowrap" id="order_info_tbl">
                                            <tr>
                                                <th class="ps-0 pb-0">
                                                    Start Date:
                                                </th>
                                                <td class="w-100 pb-0 text-wrap">
                                                    <span>
                                                        <t t-esc="order.start_date"/>
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 pb-0">End Date</th>
                                                <td class="w-100 pb-0 text-wrap">
                                                    <span>
                                                        <t t-esc="order.end_date"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div id="customer_info" class="col-12 col-lg-6 mb-4">
                                    <h5 class="mb-1">
                                        Invoicing and Shipping Address
                                    </h5>
                                    <hr class="mt-1 mb-2" data-oe-model="ir.ui.view" data-oe-id="3743"
                                        data-oe-field="arch"/>
                                    <div>
                                        <address class="o_portal_address mb-0">
                                            <div>
                                                <span itemprop="name">
                                                    <t t-esc="order.tenant_id.name"/>
                                                </span>
                                            </div>
                                            <div class="gap-2" itemscope="itemscope">
                                                <div class="d-flex align-items-baseline gap-1">
                                                    <i class="fa fa-map-marker fa-fw" role="img"
                                                       aria-label="Address"
                                                       title="Address"/>
                                                    <span class="w-100 lh-sm text-break d-block"
                                                          itemprop="streetAddress">
                                                        <t t-esc="order.tenant_id.street"/>
                                                        <br/>
                                                        <t t-esc="order.tenant_id.city"/>
                                                        <br/><t t-esc="order.tenant_id.country_id.name" />
                                                    </span>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <i class="fa fa-phone fa-fw" role="img" aria-label="Phone"
                                                       title="Phone"/>
                                                    <span class="o_force_ltr" itemprop="telephone">
                                                        <t t-esc="order.tenant_id.phone"/>
                                                    </span>
                                                </div>
                                                <div class="d-flex align-items-baseline gap-1">
                                                    <i class="fa fa-envelope fa-fw" role="img" aria-label="Email"
                                                       title="Email"/>
                                                    <span class="text-break w-100" itemprop="email">
                                                        <t t-esc="order.tenant_id.email"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </address>
                                    </div>
                                </div>
                                <section id="details" style="page-break-inside: auto;">
                                    <div class="table-responsive">
                                        <table class="table table-sm" id="rent_lease_order_table">
                                            <thead>
                                                <tr>
                                                    <th class="text-start" id="order_name_header">
                                                        Products
                                                    </th>
                                                    <th class="text-end" id="order_qty_header">
                                                        Duration
                                                    </th>
                                                    <th class="text-end d-none d-sm-table-cell"
                                                        id="order_unit_price">
                                                        Unit Price
                                                    </th>
                                                    <th class="text-end" id="subtotal_header">
                                                        <span>Amount</span>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody class="order_tbody">
                                                <t t-foreach="order.property_ids" t-as="property">
                                                    <tr>
                                                        <td>
                                                            <t t-esc="property.property_name_id.name"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <span>
                                                                <t t-esc="property.duration"/>
                                                            </span>
                                                        </td>
                                                        <td class="text-end d-none d-sm-table-cell">
                                                            <t t-esc="property.rent_lease_amount"/>
                                                        </td>
                                                        <td class="text-end" id="subtotal">
                                                            <span class="oe_order_line_price_subtotal">
                                                                <span
                                                                        class="oe_currency_value">
                                                                    <t t-esc="property.total_amount"/>
                                                                </span>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div id="total" name="total" style="page-break-inside: avoid;">
                                        <div class="col-xs-7 col-md-5 ms-auto">
                                            <table class="table table-sm" name="rent_lease_order_totals_table">
                                                <tbody>
                                                    <tr class="o_total">
                                                        <td>
                                                            <strong>Total Amount</strong>
                                                        </td>
                                                        <td class="text-end">
                                                            <span>
                                                                <t t-esc="order.sub_total"/>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
