<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    List View-->
    <record id="rental_lease_management_list_view" model="ir.ui.view">
        <field name="name">rental_lease_management_list_view</field>
        <field name="model">rental.lease.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="type"/>
            </list>
        </field>
    </record>
    <!--ental lease management search -->
    <record id="rental_lease_management_search_view" model="ir.ui.view">
        <field name="name">rental_lease_management_search</field>
        <field name="model">rental.lease.management</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="type"/>
                <filter name="filter_rent" string="Rent" domain="[('type','=','Rented')]"/>
                <filter name="filter_lease" string="Leased" domain="[('type','=','Leased')]"/>
                <group>
                    <filter name="group_by_type" string="Type" context="{'group_by':'type'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    Form View-->
    <record id="rental_lease_management_form_view" model="ir.ui.view">
        <field name="name">rental_lease_management_form_view</field>
        <field name="model">rental.lease.management</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            invisible="states in ['Draft','To_Approve' , 'Closed', 'Expired']
                             or invoice_status == 'fully_invoiced'"
                            class="oe_highlight"/>
                    <button name="action_confirm_button" type="object" string="Confirm"
                            invisible="states in ['Confirmed', 'To_Approve' , 'Closed', 'Expired']" class="oe_highlight"/>
                    <button name="action_to_approve" type="object" string="Approve"
                            groups="property_management.group_property_management_manager"
                            invisible="states != 'To_Approve'" class="oe_highlight"/>
                    <button name="action_close_button" type="object" string="Close"
                            invisible="states in ['Closed', 'To_Approve', 'Draft','Expired'   ]"/>
                    <button name="action_return_button" type="object" string="Return" invisible="states == 'Draft'"/>
                    <button name="action_expired_button" type="object" string="Expired"
                            invisible="states in ['Closed','Draft','To_Approve' ,'Expired']"/>
                    <field name="states" widget="statusbar" statusbar_visible="Draft,Confirmed,Closed,Expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="PAID" invisible="payment_status == 'not_paid'
                    or invoice_status == 'to_invoice'"
                            bg_color="text-bg-success"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="invoice_ids.state not in ['draft','posted']
                                and invoice_count &lt; 1">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <field name="name" class="h1" readonly="True"/>
                    </div>
                    <group>
                        <group>
                            <field name="tenant_id" readonly="states in ['Confirmed', 'Closed', 'Expired']"/>
                            <field name="type" widget="radio" readonly="states in ['Confirmed', 'Closed', 'Expired']"/>
                        </group>
                        <group>
                            <field name="start_date" widget="daterange" string="Start Date"
                                   options="{'end_date_field': 'end_date'}"/>
                            <field name="end_date" invisible="1"/>
                            <field name="duration" string="Duration"/>
                            <field name="company_id" string="Company"
                                   readonly="states in ['Confirmed', 'Closed', 'Expired']"/>
                        </group>
                        <notebook>
                            <page string="properties">
                                <field name="property_ids" readonly="states in ['Confirmed', 'Closed', 'Expired']">
                                    <list editable="bottom">
                                        <field name="property_name_id"/>
                                        <field name="duration"/>
                                        <field name="rent_lease_amount"/>
                                        <field name="total_amount"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group class="oe_subtotal_footer fw-bolder">
                            <div>
                                <group>
                                    <field name="sub_total"/>
                                </group>
                            </div>
                        </group>
                    </group>
                </sheet>
                <!--                Chatter Section-->
                <chatter/>
            </form>
        </field>
    </record>
    <!--    Form Action-->
    <record id="rental_lease_management_form" model="ir.actions.act_window">
        <field name="name">Rent / Lease</field>
        <field name="res_model">rental.lease.management</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create your first Order</p>
        </field>
    </record>
</odoo>