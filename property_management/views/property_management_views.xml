<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    property management list view -->
    <record id="property_management_view_list" model="ir.ui.view">
        <field name="name">property_management_view_list</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="legal_amount"/>
                <field name="rent"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>
    <!--    property management kanban view -->
    <record id="property_management_view_kanban" model="ir.ui.view">
        <field name="name">property_management_view_kanban</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="legal_amount"/>
                                <field name="property_state"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--    property management search-->
    <record id="property_management_view_search" model="ir.ui.view">
        <field name="name">property_management_view_search</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <search string="Property Search">
                <field name="name"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="owner_id"/>
                <filter name="filter" string="Can be Sold" domain="[('can_be_sold','=',True)]"/>
                <separator>
                    <filter name="archive" string="Archived" domain="[('active','=',False)]"/>
                </separator>
                <group string="Group By">
                    <filter name="country" string="Country" context="{'group_by':'country_id'}"/>
                    <filter name="property_state" string="State" context="{'group_by':'property_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    property management form view-->
    <record id="property_management_view_form" model="ir.ui.view">
        <field name="name">property_management_view_form</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="property_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="action_rent_lease_count"
                                type="object"
                                icon="fa-files-o"
                                invisible="rent_lease_count &lt; 1">
                            <div class="o_field_widget o_stat_info">
                                <field name="rent_lease_count" widget="statinfo" string="Rent/Lease"/>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <h1>
                                <field name="name" placeholder="Property Name"/>
                            </h1>
                            <field name="facilities" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="property_image" widget="image" class="oe_avatar" string=""/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <span class="o-form-label">Address</span>
                            <div class="o_address_format">
                                <field name="address" placeholder="street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State" class="o_address_state"/>
                                <field name="zip_code" placeholder="Zip" class="o_address_zip"/>
                                <div name="property_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country"/>
                                </div>
                            </div>
                            <field name="can_be_sold"/>
                            <field name="owner_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="rent"/>
                            <field name="legal_amount"/>
                            <field name="built_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--    property management view form for res partner-->
    <record id="property_management_view_2" model="ir.ui.view">
        <field name="name">Property</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rent"/>
                <field name="legal_amount"/>
                <field name="property_state"/>
            </list>
        </field>
    </record>
    <!--    property Management Form action-->
    <record id="property_management_form" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property.management</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids"
               eval="[Command.clear(),
               Command.create({'view_mode': 'list','sequence':1 ,'view_id': ref('property_management_view_list')}),
               Command.create({'view_mode': 'kanban' ,'sequence':2 ,'view_id': ref('property_management_view_kanban')})
               ]"/>
        <field name="help" type="html">
            <p>Create your First Property</p>
        </field>
    </record>
    <!--    Property Management Tag-->
    <record id="property_management_tags" model="ir.actions.act_window">
        <field name="name">Facilities - Tags</field>
        <field name="res_model">property.tags</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create Tags for Properties</p>
        </field>
    </record>
</odoo>
