<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="mail_template_order_confirmation" model="mail.template">
            <field name="name">Confirm : Email Template</field>
            <field name="model_id" ref="property_management.model_rental_lease_management"/>
            <field name="subject">Order Confirmation</field>
            <field name="email_to">{{object.tenant_id.email}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67;
                    padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px;
                    font-size:13px;width:40%">
                        <h2>
                            Hi,
                            <t t-out="object.tenant_id.name"/>
                        </h2>
                        <div>
                            <h3>This mail is to inform you that<t t-out="object.name"/>have been confirmed.
                            </h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    Regards,
                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
