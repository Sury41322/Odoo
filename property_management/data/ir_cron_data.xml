<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
        <!--        Expiry checker-->
        <record id="ir_cron_record_expiry_checker" model="ir.cron">
            <field name="name">Record Expiry Checker</field>
            <field name="model_id" ref="property_management.model_rental_lease_management"/>
            <field name="state">code</field>
            <field name="code">model.record_expiry_checker()
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <!--        payment checker-->
        <record id="ir_cron_record_payment_checker" model="ir.cron">
            <field name="name">Record Payment Checker</field>
            <field name="model_id" ref="property_management.model_rental_lease_management"/>
            <field name="state">code</field>
            <field name="code">model.record_payment_checker()
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">1</field>
        </record>
</odoo>