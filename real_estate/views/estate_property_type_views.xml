<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="action_real_estate_property_type" model="ir.actions.act_window">
            <field name="name">Property Type</field>
            <field name="res_model">estate.property.type</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="help" type="html">
                <p>Create a Property Type</p>
            </field>
        </record>
        <record id="search_real_estate_property_type" model="ir.ui.view">
            <field name="name">Property Type</field>
            <field name="model">estate.property.type</field>
            <field name = "arch" type="html">
                <search string="Property Type">
                    <field name="name"/>

                    <filter string="Property1" name="property_type1" domain="[('category','=','10')]"/>

                    <group string="Group By">
                        <filter string="Property Type" name="property_type"  context="{'group_by':'category'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>